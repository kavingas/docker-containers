[mysqld]
# Connection & Table Management (50+ databases)
max_connections         = 200
table_open_cache       = 16384        # Increased for 50+ databases
open_files_limit       = 65535
table_definition_cache = 8192         # Cache table structures

# Large Packet Support for Huge Dumps
max_allowed_packet              = 2G  # Increased for massive dumps
net_buffer_length               = 16M
bulk_insert_buffer_size         = 1G  # Critical for fast bulk inserts

# InnoDB: Optimized for SPEED (not safety)
innodb_buffer_pool_size         = 1G         # Use more RAM
innodb_buffer_pool_instances    = 1
innodb_log_file_size            = 2G         # Larger = fewer flushes
innodb_log_buffer_size          = 256M
innodb_file_per_table           = 1
innodb_flush_method             = O_DIRECT

# CRITICAL: Disable durability for max speed
innodb_flush_log_at_trx_commit  = 0          # 0 = fastest (write every ~1 sec)
innodb_doublewrite              = 0          # Disable double write buffer
innodb_flush_neighbors          = 0          # SSD optimization

# I/O Performance
innodb_io_capacity              = 4000       # Increase for SSD
innodb_io_capacity_max          = 8000
innodb_write_io_threads         = 8
innodb_read_io_threads          = 8

# Disable fsync for maximum speed (dev only!)
innodb_flush_sync               = 0

# Row Format
innodb_default_row_format       = DYNAMIC
innodb_strict_mode              = 0

# Binary Logging (disabled for dev)
skip-log-bin
sync_binlog                     = 0

# Thread & Memory Buffers
thread_cache_size               = 256
tmp_table_size                  = 1G
max_heap_table_size             = 1G
sort_buffer_size                = 16M        # Per-thread for ORDER BY
read_buffer_size                = 8M
read_rnd_buffer_size            = 16M
join_buffer_size                = 16M
myisam_sort_buffer_size         = 512M

# Query Optimization
#query_cache_type                = 0          # Disabled (deprecated)
#query_cache_size                = 0

# Import Performance
innodb_autoinc_lock_mode        = 2          # Fastest auto-increment
innodb_stats_on_metadata        = 0
innodb_stats_persistent         = 0

# Network & DNS
skip_name_resolve               = 1
max_connect_errors              = 999999

# SQL Mode (permissive for old dumps)
sql_mode = "NO_ENGINE_SUBSTITUTION,NO_AUTO_VALUE_ON_ZERO"

# Slow Query Logging (optional for debugging)
slow_query_log                  = 1
slow_query_log_file             = /tmp/mariadb-slow.log
long_query_time                 = 5
log_queries_not_using_indexes   = 0          # Don't log for speed

# Performance Schema (disabled for speed)
performance_schema              = OFF

# Character Set (UTF-8)
character_set_server            = utf8mb4
collation_server                = utf8mb4_unicode_ci

# Timezone
default_time_zone               = "+00:00"

[client-server]
max_allowed_packet = 2G

[mysql]
max_allowed_packet = 2G
prompt = \u@\h:\d\_>

[mysqldump]
max_allowed_packet = 2G
quick
single-transaction = FALSE         # Faster for dumps without consistency